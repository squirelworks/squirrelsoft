<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <RadioGroup
            android:id="@+id/makeKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/kindText"
            android:orientation="horizontal">

            <RadioButton
                android:id="@id/kindText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/make_kind_text" />

            <RadioButton
                android:id="@+id/kindWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/make_kind_wifi" />
        </RadioGroup>

        <EditText
            android:id="@+id/makeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/make_text_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:maxLines="6"
            android:minLines="2" />

        <LinearLayout
            android:id="@+id/wifiFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/wifiSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wifi_ssid"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/wifiPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/wifi_password"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword" />

            <Spinner
                android:id="@+id/wifiSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/wifiHidden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wifi_hidden" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/make_level"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/makeLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
