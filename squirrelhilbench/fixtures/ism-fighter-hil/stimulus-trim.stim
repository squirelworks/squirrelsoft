ISM-HIL stimulus 1
# Canned trim / light stick stimulus aligned with Flight Lab trim_cruise naming.
# Injects inceptor + surface command channels only (FCS / bus monitor path).
# No weapon guidance, seekers, propulsion, warheads, fuzing, or arming codes.
name: trim_cruise
dt_s: 0.05
duration_s: 1.0
step 0.0 inceptor.throttle 0.55
step 0.0 inceptor.side_stick_x 0.0
step 0.0 inceptor.side_stick_y 0.0
step 0.0 inceptor.pedals 0.0
step 0.0 actuator.cmd.eha_ht -1.5
step 0.0 actuator.cmd.eha_aileron 0.0
step 0.0 actuator.cmd.eha_rudder 0.0
step 0.4 inceptor.side_stick_y -0.2
step 0.7 inceptor.side_stick_y 0.0
