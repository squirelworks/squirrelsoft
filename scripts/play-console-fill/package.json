{
  "name": "play-console-fill",
  "version": "1.0.0",
  "private": true,
  "description": "Local Playwright CDP filler for Google Play Console App content (Suica / Sound / QR)",
  "type": "module",
  "scripts": {
    "fill": "node fill.mjs",
    "fill:suica": "node fill.mjs --app suica",
    "fill:sound": "node fill.mjs --app sound",
    "fill:qr": "node fill.mjs --app qr",
    "probe": "node fill.mjs --probe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
